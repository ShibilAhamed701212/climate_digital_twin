# Real Data Ingestion
REAL_DATA_DIR=data/real
OPEN_METEO_ENABLED=true
NASA_POWER_ENABLED=true
IMD_ENABLED=false
IMD_CLIENT_ID=
IMD_CLIENT_SECRET=
IMD_REGISTRATION_URL=https://dsp.imd.gov.in/

TWIN_STATE_MGR_PORT=8001
FORECAST_PORT=8006
SCENARIO_PORT=8002
RISK_PORT=8003
RAG_PORT=8004
COPILOT_PORT=8005
GATEWAY_PORT=8000
DASHBOARD_PORT=8501
REPORT_PORT=8007
REDIS_PORT=6379
OLLAMA_PORT=11434
GATEWAY_HOST=0.0.0.0
GATEWAY_DEBUG=false
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:8501
GATEWAY_API_KEY_ENABLED=false
GATEWAY_API_KEY=
DEMO_MODE=off
TWIN_STORE_DIR=data/twin_store
FORECAST_ENGINE_URL=http://localhost:8006
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=your-cds-api-key
DATA_DIR=/app/data
MODEL_DIR=/app/models
VECTOR_STORE_DIR=/app/knowledge/vector_store
RAG_INDEX_DIR=/rag_index
REPORT_DIR=/reports
DISASTER_PORT=8008
DISASTER_ENGINE_URL=http://localhost:8008
DISASTER_DATA_DIR=data/disaster
DISASTER_PROXY_TIMEOUT_S=120
DISASTER_MAX_UPLOAD_MB=256
TWIN_POINTER_ENABLED=true
RISK_DIE_FUSION=false
RISK_DIE_ADJUST_SCORE=false
FEATURE_ECONOMIC_LOSS=false
FEATURE_NON_FLOOD=false
MODEL_FLOOD=threshold
MODEL_FLOOD_FALLBACK=none
MODEL_OOM_FALLBACK=none
MODEL_DEVICE=auto
MODEL_RUNTIME=auto
GPU_ENABLED=false
STAC_PROVIDER=cdse
STAC_FAILOVER=false
# Official EO weights live outside the source tree when possible, e.g.
# MODEL_WEIGHTS_DIR=D:\ClimateDigitalTwin\models
MODEL_WEIGHTS_DIR=
MODEL_UNET=
MODEL_SEGFORMER=
MODEL_MASK2FORMER=
MODEL_CHANGEFORMER=
CDSE_USERNAME=
CDSE_PASSWORD=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
SH_CLIENT_ID=
SH_CLIENT_SECRET=
WORLD_POP_FETCH=false
NASADEM_FETCH=false
# Host checkpoint tree for Docker DIE (Linux path inside the container: /mnt/host-models).
# Windows example: HOST_MODEL_WEIGHTS_DIR=D:/ClimateDigitalTwin/models
# Then MODEL_WEIGHTS_UNET=/mnt/host-models/flood/unet/model.pt
# The CPU Dockerfile.disaster does not include torch; U-Net in Docker needs the learned runtime.
HOST_MODEL_WEIGHTS_DIR=./models/eo
MODEL_WEIGHTS_UNET=
MODEL_WEIGHTS_SEGFORMER=
MODEL_WEIGHTS_MASK2FORMER=
MODEL_WEIGHTS_CHANGEFORMER=
CLAMAV_HOST=
CLAMAV_PORT=3310
PLANET_API_KEY=
MAXAR_API_KEY=
EARTHENGINE_TOKEN=
RADIANT_API_KEY=
DIE_API_KEY=
DIE_ALLOWED_ORIGINS=
RATE_LIMIT_REDIS_URL=
LOG_DIR=/app/logs
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
