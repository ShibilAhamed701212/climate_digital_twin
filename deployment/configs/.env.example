# Climate Digital Twin — Environment Variables
# Copy this file to .env and customize

# Service ports
TWIN_CORE_PORT=8001
FORECAST_PORT=8002
SCENARIO_PORT=8003
RISK_PORT=8004
RAG_PORT=8005
COPILOT_PORT=8006
GATEWAY_PORT=8000
DASHBOARD_PORT=8501

# LLM configuration (for Copilot)
LLM_MODEL=qwen:4b
LLM_TEMPERATURE=0.1
OLLAMA_HOST=http://ollama:11434

# Paths (container-internal)
DATA_DIR=/app/data
MODEL_DIR=/app/models
VECTOR_STORE_DIR=/app/knowledge/vector_store
LOG_DIR=/app/logs

# Demo mode
DEMO_MODE=synthetic
