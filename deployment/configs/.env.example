# Climate Digital Twin — Environment Variables
# Copy this file to .env and customize

# Service ports — must match Dockerfile EXPOSE defaults
TWIN_STATE_MGR_PORT=8001
FORECAST_PORT=8006
SCENARIO_PORT=8002
RISK_PORT=8003
RAG_PORT=8004
COPILOT_PORT=8005
GATEWAY_PORT=8000
DASHBOARD_PORT=8501
REPORT_PORT=8007
REDIS_PORT=6379
OLLAMA_PORT=11434

# Gateway configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_DEBUG=false
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:8501
GATEWAY_API_KEY_ENABLED=true
GATEWAY_API_KEY=dev-key-change-in-production

# LLM configuration (for Copilot)
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# Paths (container-internal)
DATA_DIR=/app/data
MODEL_DIR=/app/models
VECTOR_STORE_DIR=/app/knowledge/vector_store
RAG_INDEX_DIR=/rag_index
REPORT_DIR=/reports
LOG_DIR=/app/logs

# Logging
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# Dashboard
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Demo mode
DEMO_MODE=synthetic
