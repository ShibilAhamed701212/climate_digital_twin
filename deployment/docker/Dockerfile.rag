FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir "fastapi>=0.104.0" uvicorn pydantic pyyaml sentence-transformers faiss-cpu "numpy>=1.24" "pandas>=2.0"
COPY knowledge/ ./knowledge/
COPY config/ ./config/
VOLUME /app/knowledge/vector_store
HEALTHCHECK --interval=10s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8004/health')" || exit 1
EXPOSE 8004
RUN groupadd -r appuser && useradd -r -g appuser appuser
USER appuser
CMD ["uvicorn", "knowledge.api.main:app", "--host", "0.0.0.0", "--port", "8004"]
