FROM python:3.10-slim as builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir "torch>=2.0" "pandas>=2.0" "numpy>=1.24" scikit-learn pyyaml "fastapi>=0.104.0" uvicorn
COPY models/ ./models/
COPY pipeline/ ./pipeline/
COPY config/ ./config/
VOLUME /app/models/checkpoints /app/models/exported /app/models/evaluation
HEALTHCHECK --interval=30s --timeout=10s --retries=3 CMD python -c "import torch; print('ok')" || exit 1
CMD ["python", "-m", "models.run_forecast"]
