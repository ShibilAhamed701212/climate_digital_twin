FROM python:3.11-slim
LABEL org.opencontainers.image.version="2.1.0"
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir "pandas>=2.0" "numpy>=1.24" scikit-learn pyyaml "fastapi>=0.104.0" uvicorn xgboost statsmodels shap nltk prophet
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY models/ ./models/
COPY pipeline/ ./pipeline/
COPY backend/ ./backend/
COPY config/ ./config/
COPY data/real ./data/real
RUN mkdir -p /app/data/processed /app/data/forecasts /app/data/real
VOLUME /app/models/checkpoints /app/models/exported /app/models/evaluation
HEALTHCHECK --interval=10s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8006/health')" || exit 1
EXPOSE 8006
RUN groupadd -r appuser && useradd -r -g appuser appuser && chown -R appuser:appuser /app/data
USER appuser
CMD ["uvicorn", "backend.services.forecast.main:app", "--host", "0.0.0.0", "--port", "8006"]
