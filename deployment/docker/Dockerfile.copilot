FROM python:3.10-slim
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir "fastapi>=0.104.0" uvicorn pydantic pyyaml httpx
COPY copilot/ ./copilot/
COPY config/ ./config/
HEALTHCHECK --interval=10s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8005/health')" || exit 1
EXPOSE 8005
CMD ["uvicorn", "copilot.api.main:app", "--host", "0.0.0.0", "--port", "8005"]
