FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir \
    "fastapi>=0.104.0" uvicorn pydantic pyyaml httpx \
    "pandas>=2.0" "numpy>=1.24" pyarrow duckdb faiss-cpu scikit-learn
COPY backend/ ./backend/
COPY climatedt/ ./climatedt/
COPY models/ ./models/
COPY simulator/ ./simulator/
COPY risk/ ./risk/
COPY knowledge/ ./knowledge/
COPY pipeline/ ./pipeline/
COPY config/ ./config/
ENV PYTHONPATH=/app
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1
RUN groupadd -r appuser && useradd -r -g appuser appuser && mkdir -p /home/appuser /app/data /app/data/processed && chown -R appuser:appuser /home/appuser /app/data
USER appuser
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
