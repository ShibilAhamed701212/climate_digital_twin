FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir fastapi uvicorn httpx requests
COPY backend/ backend/
COPY copilot/ copilot/
COPY config/ config/
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8007/health')"
EXPOSE 8007
RUN groupadd -r appuser && useradd -r -g appuser appuser
USER appuser
CMD ["uvicorn", "backend.api.report:app", "--host", "0.0.0.0", "--port", "8007"]
