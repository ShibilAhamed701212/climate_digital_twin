FROM python:3.10-slim
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir "fastapi>=0.104.0" uvicorn pydantic pyyaml "pandas>=2.0" "numpy>=1.24" duckdb
COPY simulator/ ./simulator/
COPY config/ ./config/
HEALTHCHECK --interval=10s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1
EXPOSE 8001
CMD ["uvicorn", "simulator.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
