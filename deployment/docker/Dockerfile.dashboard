FROM python:3.11-slim
LABEL org.opencontainers.image.version="2.1.0"
WORKDIR /app
ENV PYTHONPATH=/app
RUN pip install --no-cache-dir streamlit plotly folium streamlit-folium "pandas>=2.0" "numpy>=1.24" requests pyyaml geopandas xarray netCDF4
COPY .streamlit/ ./.streamlit/
COPY config/ ./config/
COPY copilot/ ./copilot/
COPY dashboard/ ./dashboard/
COPY pipeline/ ./pipeline/
COPY data/validation/era5/ ./data/validation/era5/
HEALTHCHECK --interval=10s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501')" || exit 1
EXPOSE 8501
RUN groupadd -r appuser && useradd -r -g appuser appuser && mkdir -p /home/appuser && chown -R appuser:appuser /home/appuser
USER appuser
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
